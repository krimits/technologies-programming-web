# ---- Server (Express) ----
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/eshop

# Secret για την υπογραφή των JWT — βάλε εδώ ένα δικό σου τυχαίο string.
# Μην μοιράζεσαι το .env (περιέχει secrets)· μοιράζεται μόνο το .env.example.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# Origin του client (Vite dev server) για το CORS
CORS_ORIGIN=http://localhost:5173

# Rounds του bcrypt
BCRYPT_ROUNDS=10
